{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cookbook-requirements",
  "title": "Requirements catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/root" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "status": { "enum": ["accepted", "implemented", "verified"] },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["normal", "shared"] },
        "status": { "$ref": "#/$defs/status" },
        "text": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/child" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "text": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/child" }
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/id" }
      }
    },
    "child": {
      "oneOf": [{ "$ref": "#/$defs/node" }, { "$ref": "#/$defs/ref" }]
    }
  }
}
