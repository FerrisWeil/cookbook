{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cookbook-requirements",
  "title": "Requirements topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "requirements"],
  "properties": {
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "title": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "removed"],
          "properties": {
            "id": { "type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$" },
            "removed": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "text", "details"],
          "properties": {
            "id": { "type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$" },
            "type": { "enum": ["functional", "non-functional", "system"] },
            "text": { "type": "string", "minLength": 1 },
            "see": { "$ref": "#/$defs/see" },
            "details": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/detail" }
            }
          }
        }
      ]
    },
    "detail": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "removed"],
          "properties": {
            "id": { "type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$" },
            "removed": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "text"],
          "properties": {
            "id": { "type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$" },
            "text": { "type": "string", "minLength": 1 },
            "implemented": { "type": "boolean" },
            "check": { "const": "manual" },
            "see": { "$ref": "#/$defs/see" }
          }
        }
      ]
    },
    "see": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*){1,2}$"
      }
    }
  }
}
