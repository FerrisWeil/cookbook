# Copy to .env next to docker-compose.yml. Never commit .env.
# Local compose requires the three POSTGRES_* passwords below. It has no default.
# Local compose sets MCP_ALLOW_DEV_TOKEN=1 for its dev token. Do not set that on the NAS.

# Bearer token for every MCP request except GET /health.
# Generate with: openssl rand -hex 32
# The server refuses this placeholder, "replace-me", and the local dev token.
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# Local compose database passwords. Three values, no defaults.
# Generate each with: openssl rand -base64 24
# The API refuses "replace-me" and "cookbook".
POSTGRES_SUPERUSER_PASSWORD=replace-me
POSTGRES_MIGRATOR_PASSWORD=replace-me
POSTGRES_APP_PASSWORD=replace-me

# NAS compose still reads this single password until that stack moves to the
# three roles above. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=replace-me

# Unraid appdata directory, outside the git checkout.
# Postgres, tailscale-web, and tailscale-mcp are subdirectories of this path.
COOKBOOK_DATA_DIR=/mnt/user/appdata/cookbook

# Unraid / Tailscale only. Leave unset for local Docker Compose.
# Two reusable, non-ephemeral auth keys: one for the web device, one for MCP.
# Create at https://login.tailscale.com/admin/settings/keys
# Paste the real keys locally. Do not use a tskey- prefix in this example file.
TS_WEB_AUTHKEY=replace-me-tailscale-web-auth-key
TS_MCP_AUTHKEY=replace-me-tailscale-mcp-auth-key

# MagicDNS name for the cookbook MCP tailnet device.
TS_MCP_HOSTNAME=cookbook-mcp

# MagicDNS name for the family web app tailnet device.
TS_WEB_HOSTNAME=cookbook

# IANA timezone matching the Unraid host (Settings → Date and Time).
TZ=America/Chicago
