# Copy to .env next to docker-compose.yml for NAS deploys.
# Never commit .env. Local `docker compose up --build` works without this file.

# Bearer token for every MCP request except GET /health.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# Postgres password. Recipes and notes live only in this database on the NAS.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=replace-me

# Unraid / Tailscale only. Leave unset for local Docker Compose.
# Reusable, non-ephemeral Tailscale auth key tagged for this project.
# Create at https://login.tailscale.com/admin/settings/keys
# Paste the real key locally. Do not use a tskey- prefix in this example file.
TS_AUTHKEY=replace-me-tailscale-auth-key

# MagicDNS name for the cookbook MCP tailnet device.
TS_MCP_HOSTNAME=cookbook-mcp

# MagicDNS name for the family web app tailnet device.
TS_WEB_HOSTNAME=cookbook

# IANA timezone matching the Unraid host (Settings → Date and Time).
TZ=America/Chicago
